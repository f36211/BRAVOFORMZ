      "description": "Frekuensi, periode, kecepatan gelombang",
      "lessons": [
        {
          "id": "getaran",
          "title": "Getaran",
          "estMinutes": 6,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Getaran"
            },
            {
              "type": "math",
              "tex": "f = n/t",
              "display": true
            },
            {
              "type": "math",
              "tex": "T = 1/f",
              "display": true
            },
            {
              "type": "text",
              "text": "Contoh: 10 getaran dalam 5 sekon → f = 10/5 = 2 Hz, T = 1/2 = 0,5 s."
            }
          ]
        },
        {
          "id": "gelombang",
          "title": "Gelombang",
          "estMinutes": 6,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Gelombang"
            },
            {
              "type": "math",
              "tex": "v = s/t",
              "display": true
            },
            {
              "type": "text",
              "text": "Contoh: gelombang 30 m dalam 12 sekon → v = 30/12 = 2,5 m/s."
            },
            {
              "type": "text",
              "text": "Contoh: 2 gabus jarak 100 cm (2 gelombang), waktu 4 detik → v = 100/4 = 25 cm/s."
            }
          ]
        }
      ],
      "flashcards": [],
      "quiz": {
        "questions": []
      }
    },
    {
      "id": "optik-dan-bunyi",
      "title": "Optik dan Bunyi",
      "description": "Cermin, sonar, tekanan hidrostatis",
      "lessons": [
        {
          "id": "cermin-cekung",
          "title": "Cermin Cekung",
          "estMinutes": 8,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Cermin Cekung"
            },
            {
              "type": "text",
              "text": "Jika benda di antara F dan cermin → bayangan maya, tegak, diperbesar, di belakang cermin."
            },
            {
              "type": "math",
              "tex": "1/f = 1/s + 1/s'",
              "display": true
            }
          ]
        },
        {
          "id": "sonar",
          "title": "Sonar",
          "estMinutes": 6,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Sonar"
            },
            {
              "type": "math",
              "tex": "d = (v x t)/2",
              "display": true
            },
            {
              "type": "text",
              "text": "Contoh: bunyi pantul 4 sekon, v = 1350 m/s → d = (1350 x 4)/2 = 2700 m."
            }
          ]
        },
        {
          "id": "tekanan-hidrostatis",
          "title": "Tekanan Hidrostatis",
          "estMinutes": 6,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Tekanan Hidrostatis"
            },
            {
              "type": "math",
              "tex": "P = rho x g x h",
              "display": true
            },
            {
              "type": "text",
              "text": "Contoh: kedalaman 15 m, rho = 1200 kg/m³, g = 10 m/s² → P = 1200 x 10 x 15 = 180.000 Pa = 180 kPa."
            }
          ]
        }
      ],
      "flashcards": [],
      "quiz": {
        "questions": []
      }
