    {
      "id": "suhu-dan-konversi",
      "title": "Suhu dan Konversi",
      "description": "Konversi Celsius ke Fahrenheit",
      "lessons": [
        {
          "id": "konversi-suhu",
          "title": "Konversi Celsius dan Fahrenheit",
          "estMinutes": 8,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Konversi Suhu"
            },
            {
              "type": "math",
              "tex": "F = (9/5 x C) + 32",
              "display": true
            },
            {
              "type": "math",
              "tex": "C = 5/9 x (F - 32)",
              "display": true
            },
            {
              "type": "text",
              "text": "Contoh: 85°C = (9/5 x 85) + 32 = 153 + 32 = 185°F. Contoh lain: 40°C = (9/5 x 40) + 32 = 72 + 32 = 104°F."
            }
          ]
        }
      ],
      "flashcards": [],
      "quiz": {
        "questions": []
