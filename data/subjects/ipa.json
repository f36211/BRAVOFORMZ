    {
      "id": "listrik",
      "title": "Listrik",
      "description": "Listrik statis, Coulomb, Ohm, rangkaian listrik",
      "lessons": [
        {
          "id": "listrik-statis",
          "title": "Listrik Statis",
          "estMinutes": 6,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Listrik Statis"
            },
            {
              "type": "text",
              "text": "Menggosok sisir plastik ke rambut: elektron rambut pindah ke sisir → sisir bermuatan negatif."
            },
            {
              "type": "text",
              "text": "Muatan sejenis tolak-menolak, muatan berbeda tarik-menarik."
            }
          ]
        },
        {
          "id": "hukum-coulomb",
          "title": "Hukum Coulomb",
          "estMinutes": 8,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Hukum Coulomb"
            },
            {
              "type": "math",
              "tex": "F = k x q1 x q2 / r^2",
              "display": true
            },
            {
              "type": "text",
              "text": "Contoh: q1 = 3 C, q2 = 4 C, r = 0,3 m, k = 9 x 10^9 → F = 9 x 10^9 x 12 / 0,09 = 1,2 x 10^12 N."
            }
          ]
        },
        {
          "id": "rangkaian-listrik",
          "title": "Rangkaian Listrik",
          "estMinutes": 10,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Rangkaian Listrik"
            },
            {
              "type": "math",
              "tex": "V = I x R",
              "display": true
            },
            {
              "type": "text",
              "text": "Paralel: 1/R_total = 1/R1 + 1/R2 + 1/R3. Arus terbagi tiap cabang."
            },
            {
              "type": "text",
              "text": "Seri: R_total = R1 + R2 + R3. Arus sama besar."
            },
            {
              "type": "text",
              "text": "Contoh: R1 = 1Ω seri dengan R2(3Ω) paralel R3(6Ω). Rp = (3x6)/(3+6) = 2Ω. R_total = 1+2 = 3Ω. I = 6V/3Ω = 2A."
            }
          ]
        },
        {
          "id": "magnet",
          "title": "Magnet dan GGL Induksi",
          "estMinutes": 8,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Magnet dan GGL Induksi"
            },
            {
              "type": "text",
              "text": "Membuat magnet: gosok kutub magnet pada baja searah berulang-ulang. Ujung awal gosokan berlawanan dengan kutub magnet penggosok."
            },
            {
              "type": "text",
              "text": "GGL Induksi dihasilkan dengan menggerakkan magnet keluar-masuk kumparan secara berulang. Magnet diam tidak menghasilkan GGL."
            }
          ]
        },
        {
          "id": "energi-listrik",
          "title": "Energi Listrik dan Biaya",
          "estMinutes": 10,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Energi Listrik dan Biaya"
            },
            {
              "type": "math",
              "tex": "E = P x t",
              "display": true
            },
            {
              "type": "text",
              "text": "Contoh perhitungan: 2 lampu 5W (10 jam), 4 lampu 10W (10 jam), pompa 250W (2 jam), kulkas 50W (24 jam), TV 100W (5 jam), setrika 200W (1 jam)."
            },
            {
              "type": "text",
              "text": "Total harian = 2.900 Wh = 2,9 kWh. Per bulan (30 hari) = 87 kWh. Biaya = (87 x Rp 1.400) + Rp 20.000 = Rp 141.800."
            }
          ]
        }
      ],
