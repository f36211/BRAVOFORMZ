    {
      "id": "genetika",
      "title": "Genetika",
      "description": "Hukum Mendel, dominasi, golongan darah, bioteknologi",
      "lessons": [
        {
          "id": "hukum-mendel",
          "title": "Hukum Mendel",
          "estMinutes": 8,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Hukum Mendel"
            },
            {
              "type": "text",
              "text": "Monohibrid: BB x bb → F1 semua Bb (bulat). F1 x F1 → F2: 3 bulat : 1 keriput."
            }
          ]
        },
        {
          "id": "inkomplet-dominasi",
          "title": "Inkomplet Dominasi",
          "estMinutes": 8,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Inkomplet Dominasi"
            },
            {
              "type": "text",
              "text": "Mawar merah (MM) x mawar putih (mm) → F1 semua merah muda (Mm)."
            },
            {
              "type": "text",
              "text": "F1 x F1 → F2: 1 merah : 2 merah muda : 1 putih."
            },
            {
              "type": "text",
              "text": "Genotipe F2: 1 MM : 2 Mm : 1 mm (25% : 50% : 25%)."
            }
          ]
        },
        {
          "id": "golongan-darah",
          "title": "Golongan Darah",
          "estMinutes": 6,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Golongan Darah"
            },
            {
              "type": "text",
              "text": "Pria AB (IA IB) x Wanita O (ii) → Anak: 50% A (IA i) dan 50% B (IB i)."
            }
          ]
        },
        {
          "id": "bioteknologi",
          "title": "Bioteknologi",
