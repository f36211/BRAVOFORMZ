      "lessons": [
        {
          "id": "sifat-zat",
          "title": "Sifat dan Karakteristik Zat",
          "estMinutes": 8,
          "content": [
            { "type": "heading", "text": "Karakteristik Zat" },
            { "type": "text", "text": "Zat adalah segala sesuatu yang memiliki massa dan menempati ruang. Zat dapat diklasifikasikan berdasarkan wujudnya menjadi padat, cair, dan gas." },
            { "type": "heading", "level": 2, "text": "Partikel Penyusun Zat" },
            { "type": "table", "headers": ["Wujud", "Susunan Partikel", "Gerakan", "Jarak Antar Partikel"], "rows": [
              ["Padat (Solid)", "Teratur rapat", "Bergetar di tempat", "Sangat dekat"],
              ["Cair (Liquid)", "Tidak teratur", "Bergerak bebas terbatas", "Dekat"],
              ["Gas", "Sangat tidak teratur", "Bergerak bebas ke segala arah", "Sangat jauh"]
            ]},
            { "type": "heading", "level": 2, "text": "Perubahan Wujud Zat" },
            { "type": "list", "items": [
              "Mencair: padat → cair (es mencair)",
              "Membeku: cair → padat (air menjadi es)",
              "Menguap: cair → gas (air mendidih)",
              "Mengembun: gas → cair (embun pagi)",
              "Menyublim: padat → gas (kapur barus)",
              "Mengkristal: gas → padat (salju)"
            ]},
            { "type": "highlight", "text": "Segitiga perubahan zat: Padat ↔ Cair ↔ Gas" }
          ]
        }
      ],
      "flashcards": [
        { "id": "fc1", "question": "Sebutkan 3 wujud zat!", "answer": "Padat, cair, dan gas" },
        { "id": "fc2", "question": "Apa yang dimaksud menyublim?", "answer": "Perubahan wujud dari padat langsung menjadi gas" },
        { "id": "fc3", "question": "Contoh proses mengkristal?", "answer": "Pembentukan salju dari uap air" },
        { "id": "fc4", "question": "Bagaimana susunan partikel zat padat?", "answer": "Teratur dan rapat, hanya bergetar di tempat" }
      ],
      "quiz": {
        "questions": [
          { "id": "q1", "type": "multiple_choice", "question": "Perubahan wujud dari cair menjadi gas disebut?", "options": ["Mencair", "Membeku", "Menguap", "Menyublim"], "answer": 2 },
          { "id": "q2", "type": "multiple_choice", "question": "Contoh zat yang dapat menyublim adalah?", "options": ["Es batu", "Air", "Kapur barus", "Minyak"], "answer": 2, "explanation": "Kapur barus (kamfer) dapat berubah dari padat langsung menjadi gas tanpa mencair terlebih dahulu." }
        ]
      }
    },
    {
      "id": "gaya-newton",
      "title": "Hukum Newton",
      "description": "Hukum Newton 1, 2, 3 dan aplikasinya",
      "bookmarked": false,
      "lessons": [
        {
          "id": "hukum-newton",
          "title": "Tiga Hukum Newton",
          "estMinutes": 12,
          "content": [
            { "type": "heading", "text": "Hukum Newton tentang Gerak" },
            { "type": "heading", "level": 2, "text": "Hukum Newton I (Inersia)" },
            { "type": "text", "text": "Setiap benda akan tetap diam atau bergerak lurus beraturan jika tidak ada gaya yang bekerja padanya (resultan gaya = 0)." },
            { "type": "highlight", "text": "Contoh: Penumpang terdorong ke depan saat bus direm mendadak" },
            { "type": "heading", "level": 2, "text": "Hukum Newton II" },
            { "type": "math", "tex": "F = m \\times a", "display": true },
            { "type": "text", "text": "Percepatan berbanding lurus dengan gaya dan berbanding terbalik dengan massa. Satuan gaya adalah Newton (N)." },
            { "type": "heading", "level": 2, "text": "Hukum Newton III (Aksi-Reaksi)" },
            { "type": "text", "text": "Setiap aksi selalu ada reaksi yang sama besar tetapi berlawanan arah." },
            { "type": "list", "items": [
              "Mendorong tembok → tembok mendorong balik",
              "Roket meluncur → gas terdorong ke bawah",
              "Berenang → air didorong ke belakang"
            ]},
            { "type": "heading", "level": 2, "text": "GLB dan GLBB" },
            { "type": "table", "headers": ["Jenis Gerak", "Kecepatan", "Percepatan"], "rows": [
              ["GLB (Gerak Lurus Beraturan)", "Konstan", "0"],
              ["GLBB (Gerak Lurus Berubah Beraturan)", "Berubah teratur", "Konstan"]
            ]}
          ]
        }
      ],
      "flashcards": [
        { "id": "fc1", "question": "Rumus Hukum Newton II?", "answer": "F = m × a" },
        { "id": "fc2", "question": "Apa yang dimaksud inersia?", "answer": "Kecenderungan benda mempertahankan keadaan geraknya" },
        { "id": "fc3", "question": "Contoh Hukum Newton III?", "answer": "Roket meluncur ke atas, gas terdorong ke bawah" },
        { "id": "fc4", "question": "Apa perbedaan GLB dan GLBB?", "answer": "GLB: kecepatan konstan; GLBB: kecepatan berubah teratur" }
      ],
      "quiz": {
        "questions": [
          { "id": "q1", "type": "multiple_choice", "question": "Benda bermassa 5 kg diberi gaya 20 N. Berapakah percepatannya?", "options": ["2 m/s²", "4 m/s²", "25 m/s²", "100 m/s²"], "answer": 1, "explanation": "a = F/m = 20/5 = 4 m/s²" },
          { "id": "q2", "type": "multiple_choice", "question": "Hukum Newton I juga disebut hukum?", "options": ["Aksi-reaksi", "Kelembaman", "Gravitasi", "Kekekalan energi"], "answer": 1 }
        ]
      }
    },
