            },
            {
              "type": "text",
              "text": "Ketelitian mikrometer sekrup: 0,01 mm. Terdiri dari skala utama (sleeve) dan skala putar (thimble)."
            },
            {
              "type": "math",
              "tex": "Hasil = Skala Utama + (Skala Putar x 0,01 mm)",
              "display": true
            },
            {
              "type": "text",
              "text": "Contoh: skala utama 6,5 mm, skala putar 34 → 6,5 + 0,34 = 6,84 mm. Contoh lain: skala utama 5,5 mm, skala putar 33 → 5,5 + 0,33 = 5,83 mm."
            }
          ]
        }
