              "level": 1,
              "text": "Ciri-ciri Makhluk Hidup"
            },
            {
              "type": "text",
              "text": "Ciri makhluk hidup: bergerak, peka terhadap rangsangan, mengalami pertumbuhan, memerlukan makanan, mengeluarkan zat sisa."
            }
          ]
        },
        {
          "id": "jaringan-tumbuhan",
          "title": "Jaringan Tumbuhan",
          "estMinutes": 8,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Jaringan Tumbuhan"
            },
            {
              "type": "text",
              "text": "Epidermis: melindungi jaringan di bawahnya."
            },
            {
              "type": "text",
              "text": "Palisade: tempat fotosintesis (banyak kloroplas)."
            },
            {
              "type": "text",
              "text": "Stomata (mulut daun): jalan keluar masuknya udara, mengatur penguapan air."
            },
            {
              "type": "text",
              "text": "Bunga karang (sponsy): tempat penguapan air."
            }
          ]
        },
        {
          "id": "fotosintesis",
          "title": "Fotosintesis",
          "estMinutes": 6,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Fotosintesis"
            },
            {
              "type": "math",
              "tex": "6CO2 + 6H2O -> C6H12O6 + 6O2",
              "display": true
            },
            {
              "type": "text",
              "text": "Percobaan hydrilla: tumbuhan di tempat terang menghasilkan oksigen lebih banyak dari tempat teduh."
            }
          ]
        },
        {
          "id": "klasifikasi-tumbuhan",
          "title": "Monokotil dan Dikotil",
          "estMinutes": 8,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Monokotil vs Dikotil"
            },
            {
              "type": "table",
              "headers": [
                "Pembeda",
                "Monokotil",
                "Dikotil"
              ],
              "rows": [
                [
                  "Akar",
                  "Serabut",
                  "Tunggang"
                ],
                [
                  "Batang",
                  "Tidak bercabang, tidak berkambium",
                  "Bercabang, berkambium"
                ],
                [
                  "Daun",
                  "Sejajar/melengkung",
                  "Menyirip/menjari"
                ],
                [
                  "Bunga",
                  "Kelipatan 3",
                  "Kelipatan 4 atau 5"
                ]
              ]
            }
          ]
        },
        {
          "id": "klasifikasi-hewan",
          "title": "Klasifikasi Hewan",
          "estMinutes": 10,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Klasifikasi Hewan"
            },
            {
              "type": "text",
              "text": "Penutup tubuh Pisces: sisik. Mamalia: rambut/bulu."
            },
            {
              "type": "text",
              "text": "Alat gerak Pisces: sirip. Mamalia: kaki."
            },
            {
              "type": "text",
              "text": "Suhu tubuh Pisces: berdarah dingin. Mamalia: berdarah panas."
            },
            {
              "type": "text",
              "text": "Fertilisasi Pisces: eksternal. Mamalia: internal."
            },
            {
              "type": "text",
              "text": "Reproduksi Pisces: ovipar (bertelur). Mamalia: vivipar (beranak)."
            },
            {
              "type": "text",
              "text": "Alat pernapasan Pisces: insang. Mamalia: paru-paru."
            },
            {
              "type": "text",
              "text": "Kekerabatan paling dekat: udang dan kepiting (sama-sama Crustacea)."
            }
          ]
        },
        {
          "id": "ekosistem",
          "title": "Ekosistem",
          "estMinutes": 10,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Ekosistem"
            },
            {
              "type": "text",
              "text": "Predasi: harimau memangsa rusa."
            },
            {
              "type": "text",
              "text": "Kompetisi: rusa dan zebra bersaing memakan rumput."
            },
            {
              "type": "text",
              "text": "Simbiosis Mutualisme: lebah dan bunga (saling menguntungkan)."
            },
            {
              "type": "text",
              "text": "Simbiosis Parasitisme: benalu pada pohon randu (benalu diuntungkan, randu dirugikan)."
            },
            {
              "type": "text",
              "text": "Simbiosis Komensalisme: anggrek hutan pada pohon randu (anggrek diuntungkan, randu tidak dirugikan)."
            },
            {
              "type": "text",
              "text": "Jika harimau punah: populasi rusa/kelinci naik, populasi tumbuhan turun (overgrazing)."
            }
          ]
        }
      ],
