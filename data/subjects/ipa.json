    {
      "id": "listrik",
      "title": "Listrik Statis dan Dinamis",
      "description": "Gejala kelistrikan dan rangkaian listrik",
      "bookmarked": false,
      "lessons": [
        {
          "id": "listrik-statis-dinamis",
          "title": "Listrik Statis dan Dinamis",
          "estMinutes": 15,
          "content": [
            { "type": "heading", "text": "Listrik Statis" },
            { "type": "text", "text": "Listrik statis adalah listrik yang tidak mengalir (muatan diam). Terjadi akibat perpindahan elektron." },
            { "type": "list", "items": [
              "Muatan sejenis tolak-menolak",
              "Muatan berbeda tarik-menarik",
              "Contoh: petir, rambut berdiri saat disisir"
            ]},
            { "type": "heading", "level": 2, "text": "Hukum Coulomb" },
            { "type": "math", "tex": "F = k \\frac{q_1 \\cdot q_2}{r^2}", "display": true },
            { "type": "text", "text": "F = gaya Coulomb (N), k = 9×10⁹ Nm²/C², q = muatan (C), r = jarak (m)" },
            { "type": "heading", "text": "Listrik Dinamis" },
            { "type": "text", "text": "Listrik dinamis adalah listrik yang mengalir (arus listrik)." },
            { "type": "heading", "level": 2, "text": "Hukum Ohm" },
            { "type": "math", "tex": "V = I \\times R", "display": true },
            { "type": "text", "text": "V = tegangan (Volt), I = arus (Ampere), R = hambatan (Ohm)" },
            { "type": "heading", "level": 2, "text": "Rangkaian Listrik" },
            { "type": "table", "headers": ["Jenis", "Hambatan Total", "Ciri"], "rows": [
              ["Seri", "R_total = R₁ + R₂ + ...", "Arus sama, tegangan berbagi"],
              ["Paralel", "1/R_total = 1/R₁ + 1/R₂ + ...", "Tegangan sama, arus berbagi"]
            ]},
            { "type": "heading", "level": 2, "text": "Daya dan Energi Listrik" },
            { "type": "math", "tex": "P = V \\times I = I^2 \\times R = \\frac{V^2}{R}", "display": true },
            { "type": "math", "tex": "W = P \\times t", "display": true },
            { "type": "highlight", "text": "Biaya listrik = kWh × tarif per kWh" }
          ]
        }
      ],
      "flashcards": [
        { "id": "fc1", "question": "Rumus Hukum Ohm?", "answer": "V = I × R" },
        { "id": "fc2", "question": "Rumus daya listrik?", "answer": "P = V × I" },
        { "id": "fc3", "question": "Hambatan total rangkaian seri?", "answer": "R_total = R₁ + R₂ + R₃ + ..." },
        { "id": "fc4", "question": "Apa yang dimaksud listrik statis?", "answer": "Listrik yang tidak mengalir (muatan diam)" }
      ],
      "quiz": {
        "questions": [
          { "id": "q1", "type": "multiple_choice", "question": "Tegangan 12V, arus 2A. Berapakah hambatannya?", "options": ["6 Ohm", "24 Ohm", "10 Ohm", "14 Ohm"], "answer": 0, "explanation": "R = V/I = 12/2 = 6 Ohm" },
          { "id": "q2", "type": "multiple_choice", "question": "Muatan sejenis akan?", "options": ["Tarik-menarik", "Tolak-menolak", "Netral", "Tidak berpengaruh"], "answer": 1 }
        ]
      }
    },
    {
      "id": "genetika",
      "title": "Genetika (Pewarisan Sifat)",
      "description": "Hukum Mendel dan persilangan",
      "bookmarked": false,
      "lessons": [
        {
          "id": "pewarisan-sifat",
          "title": "Pewarisan Sifat",
          "estMinutes": 12,
          "content": [
            { "type": "heading", "text": "Genetika dan Pewarisan Sifat" },
            { "type": "heading", "level": 2, "text": "Istilah Penting" },
            { "type": "list", "items": [
              "Gen: unit pewarisan sifat pada kromosom",
              "Alel: variasi dari suatu gen (dominan/resesif)",
              "Genotipe: susunan gen (Aa, AA, aa)",
              "Fenotipe: sifat yang tampak (tinggi, pendek)",
              "Homozigot: alel sama (AA atau aa)",
              "Heterozigot: alel berbeda (Aa)"
            ]},
            { "type": "heading", "level": 2, "text": "Persilangan Monohibrid" },
            { "type": "text", "text": "Persilangan dengan satu sifat beda. Contoh: Aa × Aa" },
            { "type": "table", "headers": ["", "A", "a"], "rows": [
              ["A", "AA", "Aa"],
              ["a", "Aa", "aa"]
            ]},
            { "type": "text", "text": "Hasil: AA : Aa : aa = 1 : 2 : 1 (genotipe)" },
            { "type": "text", "text": "Fenotipe: Dominan : Resesif = 3 : 1" },
            { "type": "heading", "level": 2, "text": "Golongan Darah" },
            { "type": "table", "headers": ["Golongan", "Genotipe"], "rows": [
              ["A", "I^A I^A atau I^A i"],
              ["B", "I^B I^B atau I^B i"],
              ["AB", "I^A I^B"],
              ["O", "ii"]
            ]},
            { "type": "highlight", "text": "Golongan darah O bersifat resesif terhadap A dan B." }
          ]
        }
      ],
      "flashcards": [
        { "id": "fc1", "question": "Apa perbedaan genotipe dan fenotipe?", "answer": "Genotipe = susunan gen; Fenotipe = sifat yang tampak" },
        { "id": "fc2", "question": "Rasio fenotipe persilangan Aa × Aa?", "answer": "3 : 1 (dominan : resesif)" },
        { "id": "fc3", "question": "Genotipe golongan darah AB?", "answer": "I^A I^B" },
        { "id": "fc4", "question": "Apa itu heterozigot?", "answer": "Individu dengan dua alel berbeda (contoh: Aa)" }
      ],
