    {
      "id": "gaya-dan-gerak",
      "title": "Gaya dan Gerak",
      "description": "Hukum Newton, GLB, GLBB, energi, usaha",
      "lessons": [
        {
          "id": "hukum-newton",
          "title": "Hukum Newton",
          "estMinutes": 10,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Hukum Newton"
            },
            {
              "type": "text",
              "text": "Percepatan berbanding lurus dengan resultan gaya dan berbanding terbalik dengan massa."
            },
            {
              "type": "math",
              "tex": "F = m x a",
              "display": true
            },
            {
              "type": "text",
              "text": "Benda dengan gaya resultan terbesar memiliki percepatan terbesar (jika massa sama)."
            }
          ]
        },
        {
          "id": "glb-glbb",
          "title": "GLB dan GLBB",
          "estMinutes": 8,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Gerak Lurus"
            },
            {
              "type": "text",
              "text": "GLB (Gerak Lurus Beraturan): kecepatan tetap. Contoh: kereta 90 km/jam, jarak 180 km → waktu = 2 jam."
            },
            {
              "type": "text",
              "text": "GLBB Dipercepat: kecepatan bertambah. Contoh: sepeda menuruni lereng."
            },
            {
              "type": "text",
              "text": "GLBB Diperlambat: kecepatan berkurang. Contoh: bola dilempar ke atas."
            }
          ]
        },
        {
          "id": "energi-potensial",
          "title": "Energi Potensial",
          "estMinutes": 6,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Energi Potensial"
            },
            {
              "type": "math",
              "tex": "Ep = m x g x h",
              "display": true
            },
            {
              "type": "text",
              "text": "Contoh: sangkar burung 2 kg, h = 8 m, g = 10 m/s² → Ep = 2 x 10 x 8 = 160 J."
            },
            {
              "type": "text",
              "text": "Contoh: buah kelapa 2 kg, h = 6 m → Ep = 2 x 10 x 6 = 120 J."
            }
          ]
        },
        {
          "id": "usaha",
          "title": "Usaha (Work)",
          "estMinutes": 6,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Usaha"
            },
            {
              "type": "math",
              "tex": "W = F x s",
              "display": true
            },
            {
              "type": "text",
              "text": "Contoh: gaya A = 120 N, gaya B = 180 N, usaha 1800 J → jarak = 1800 / (120 + 180) = 6 m."
            }
          ]
        }
      ],
      "flashcards": [],
      "quiz": {
        "questions": []
      }
    },
    {
      "id": "pesawat-sederhana",
      "title": "Pesawat Sederhana",
      "description": "Tuas dan Hukum Pascal",
      "lessons": [
        {
          "id": "tuas",
          "title": "Tuas",
          "estMinutes": 10,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Tuas"
            },
            {
              "type": "text",
              "text": "Tuas Jenis I: titik tumpu di tengah (gunting, jungkat-jungkit)."
            },
            {
              "type": "text",
              "text": "Tuas Jenis II: beban di tengah (gerobak dorong, pembuka botol)."
            },
            {
              "type": "text",
              "text": "Tuas Jenis III: kuasa di tengah (pancing, lengan manusia)."
            },
            {
              "type": "math",
              "tex": "F1 x d1 = F2 x d2",
              "display": true
            },
            {
              "type": "text",
              "text": "Contoh: batu 480 N, beban 20 cm, kuasa 120 cm → gaya kuasa = (480 x 20)/120 = 80 N. Keuntungan mekanik = 120/20 = 6."
            },
            {
              "type": "text",
              "text": "Contoh: W = 90 N, AB = 30 cm, AC = 120 cm → F = (90 x 30)/120 = 22,5 N."
            }
          ]
        },
        {
          "id": "hukum-pascal",
          "title": "Hukum Pascal (Hidrolik)",
          "estMinutes": 8,
          "content": [
            {
              "type": "heading",
              "level": 1,
              "text": "Hukum Pascal"
            },
            {
              "type": "math",
              "tex": "F1/A1 = F2/A2",
              "display": true
            },
            {
              "type": "text",
              "text": "Contoh: A1 = 20 cm², A2 = 70 cm², F1 = 350 N → F2 = 350 x (70/20) = 1.225 N."
            }
          ]
        }
      ],
      "flashcards": [],
      "quiz": {
        "questions": []
      }
    },
    {
      "id": "getaran-gelombang",
