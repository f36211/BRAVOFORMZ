        {
          "id": "bilangan-bulat",
          "title": "Bilangan Bulat dan Rasional",
          "estMinutes": 10,
          "content": [
            { "type": "heading", "text": "Bilangan Bulat dan Rasional" },
            { "type": "heading", "level": 2, "text": "Jenis Bilangan" },
            { "type": "list", "items": [
              "Bilangan bulat: ..., -2, -1, 0, 1, 2, ...",
              "Bilangan cacah: 0, 1, 2, 3, ...",
              "Bilangan asli: 1, 2, 3, 4, ...",
              "Bilangan rasional: dapat dinyatakan sebagai a/b (b ≠ 0)",
              "Bilangan irasional: tidak dapat dinyatakan sebagai pecahan (π, √2)"
            ]},
            { "type": "heading", "level": 2, "text": "Operasi Bilangan Bulat" },
            { "type": "list", "items": [
              "Positif × Positif = Positif",
              "Negatif × Negatif = Positif",
              "Positif × Negatif = Negatif",
              "(-a) × (-b) = ab"
            ]},
            { "type": "heading", "level": 2, "text": "Operasi Pecahan" },
            { "type": "math", "tex": "\\frac{a}{b} + \\frac{c}{d} = \\frac{ad + bc}{bd}", "display": true },
            { "type": "math", "tex": "\\frac{a}{b} \\times \\frac{c}{d} = \\frac{ac}{bd}", "display": true },
            { "type": "math", "tex": "\\frac{a}{b} \\div \\frac{c}{d} = \\frac{a}{b} \\times \\frac{d}{c}", "display": true }
          ]
        }
      ],
      "flashcards": [
        { "id": "fc1", "question": "Hasil dari (-5) × (-3)?", "answer": "15 (negatif kali negatif = positif)" },
        { "id": "fc2", "question": "Apa itu bilangan irasional?", "answer": "Bilangan yang tidak dapat dinyatakan sebagai pecahan" },
        { "id": "fc3", "question": "Contoh bilangan irasional?", "answer": "π, √2, √3" },
        { "id": "fc4", "question": "Cara membagi pecahan?", "answer": "Kali dengan kebalikan pembagi" }
