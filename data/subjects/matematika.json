    {
      "id": "himpunan",
      "title": "Himpunan",
      "description": "Himpunan, operasi, dan diagram Venn",
      "bookmarked": false,
      "lessons": [
        {
          "id": "operasi-himpunan",
          "title": "Operasi Himpunan",
          "estMinutes": 12,
          "content": [
            { "type": "heading", "text": "Himpunan dan Operasinya" },
            { "type": "heading", "level": 2, "text": "Jenis Himpunan" },
            { "type": "list", "items": [
              "Himpunan semesta (S): himpunan yang memuat semua anggota",
              "Himpunan kosong (∅): himpunan tanpa anggota",
              "Himpunan bagian (⊂): A ⊂ B jika semua anggota A ada di B"
            ]},
            { "type": "heading", "level": 2, "text": "Operasi Himpunan" },
            { "type": "table", "headers": ["Operasi", "Simbol", "Pengertian"], "rows": [
              ["Irisan", "A ∩ B", "Anggota yang ada di A dan B"],
              ["Gabungan", "A ∪ B", "Semua anggota A dan B"],
              ["Selisih", "A - B", "Anggota A yang tidak ada di B"],
              ["Komplemen", "A'", "Anggota S yang tidak ada di A"]
            ]},
            { "type": "heading", "level": 2, "text": "Diagram Venn" },
            { "type": "text", "text": "Diagram Venn digunakan untuk menggambarkan hubungan antar himpunan secara visual." },
            { "type": "highlight", "text": "n(A ∪ B) = n(A) + n(B) - n(A ∩ B)" }
          ]
        }
      ],
      "flashcards": [
        { "id": "fc1", "question": "Apa itu irisan himpunan?", "answer": "Anggota yang sama-sama ada di kedua himpunan" },
        { "id": "fc2", "question": "Simbol gabungan himpunan?", "answer": "A ∪ B" },
        { "id": "fc3", "question": "Rumus n(A ∪ B)?", "answer": "n(A) + n(B) - n(A ∩ B)" },
        { "id": "fc4", "question": "Apa itu komplemen A?", "answer": "Anggota semesta yang tidak ada di A" }
      ],
      "quiz": {
        "questions": [
          { "id": "q1", "type": "multiple_choice", "question": "A = {1,2,3}, B = {2,3,4}. A ∩ B = ?", "options": ["{1,2,3,4}", "{2,3}", "{1,4}", "{}"], "answer": 1 },
          { "id": "q2", "type": "multiple_choice", "question": "n(A)=10, n(B)=8, n(A∩B)=3. n(A∪B)=?", "options": ["15", "18", "21", "5"], "answer": 0, "explanation": "n(A∪B) = 10 + 8 - 3 = 15" }
        ]
      }
    },
