          "content": [
            { "type": "heading", "text": "Perbandingan dan Skala" },
            { "type": "heading", "level": 2, "text": "Perbandingan Senilai" },
            { "type": "text", "text": "Dua besaran dikatakan senilai jika satu besaran naik, besaran lain juga naik." },
            { "type": "math", "tex": "\\frac{a_1}{a_2} = \\frac{b_1}{b_2}", "display": true },
            { "type": "text", "text": "Contoh: jumlah barang dan total harga" },
            { "type": "heading", "level": 2, "text": "Perbandingan Berbalik Nilai" },
            { "type": "text", "text": "Dua besaran dikatakan berbalik nilai jika satu besaran naik, besaran lain turun." },
            { "type": "math", "tex": "a_1 \\times b_1 = a_2 \\times b_2", "display": true },
            { "type": "text", "text": "Contoh: kecepatan dan waktu tempuh" },
            { "type": "heading", "level": 2, "text": "Skala Peta" },
            { "type": "math", "tex": "Skala = \\frac{Jarak\\ pada\\ peta}{Jarak\\ sebenarnya}", "display": true },
            { "type": "highlight", "text": "Skala 1:100.000 artinya 1 cm di peta = 100.000 cm = 1 km sebenarnya" }
          ]
        }
      ],
      "flashcards": [
