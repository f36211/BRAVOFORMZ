      "id": "aljabar",
      "title": "Aljabar",
      "description": "Bentuk aljabar dan persamaan linear",
      "bookmarked": true,
      "lessons": [
        {
          "id": "persamaan-linear",
          "title": "Persamaan Linear",
          "estMinutes": 12,
          "content": [
            { "type": "heading", "text": "Persamaan dan Pertidaksamaan Linear" },
            { "type": "heading", "level": 2, "text": "PLSV (Satu Variabel)" },
            { "type": "math", "tex": "ax + b = 0 \\Rightarrow x = -\\frac{b}{a}", "display": true },
            { "type": "text", "text": "Contoh: 2x + 6 = 0 → x = -3" },
            { "type": "heading", "level": 2, "text": "SPLDV (Dua Variabel)" },
            { "type": "text", "text": "Sistem persamaan dengan dua variabel, diselesaikan dengan:" },
            { "type": "list", "items": [
              "Metode substitusi: ganti salah satu variabel",
              "Metode eliminasi: hilangkan salah satu variabel",
              "Metode grafik: titik potong dua garis"
            ]},
            { "type": "heading", "level": 2, "text": "Contoh SPLDV" },
            { "type": "text", "text": "x + y = 5 dan x - y = 1" },
            { "type": "text", "text": "Eliminasi: 2x = 6 → x = 3, maka y = 2" },
            { "type": "highlight", "text": "Periksa jawaban dengan substitusi ke persamaan awal!" }
          ]
        }
      ],
      "flashcards": [
        { "id": "fc1", "question": "Bentuk umum PLSV?", "answer": "ax + b = 0, a ≠ 0" },
        { "id": "fc2", "question": "Solusi 3x - 9 = 0?", "answer": "x = 3" },
        { "id": "fc3", "question": "Sebutkan 3 metode SPLDV!", "answer": "Substitusi, eliminasi, grafik" },
        { "id": "fc4", "question": "x + y = 7, x - y = 3. x = ?", "answer": "x = 5 (eliminasi: 2x = 10)" }
      ],
      "quiz": {
        "questions": [
