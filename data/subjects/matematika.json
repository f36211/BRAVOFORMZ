      "lessons": [
        {
          "id": "untung-rugi",
          "title": "Untung, Rugi, dan Persentase",
          "estMinutes": 10,
          "content": [
            { "type": "heading", "text": "Aritmatika Sosial" },
            { "type": "heading", "level": 2, "text": "Keuntungan dan Kerugian" },
            { "type": "list", "items": [
              "Untung = Harga jual - Harga beli (jika HJ > HB)",
              "Rugi = Harga beli - Harga jual (jika HB > HJ)",
              "Persentase untung = (Untung/HB) × 100%",
              "Persentase rugi = (Rugi/HB) × 100%"
            ]},
            { "type": "heading", "level": 2, "text": "Diskon dan Pajak" },
            { "type": "list", "items": [
              "Diskon = potongan harga",
              "Harga setelah diskon = Harga awal × (100% - diskon%)",
              "PPN = Pajak Pertambahan Nilai (biasanya 10% atau 11%)"
            ]},
            { "type": "heading", "level": 2, "text": "Bruto, Neto, Tara" },
            { "type": "table", "headers": ["Istilah", "Pengertian"], "rows": [
              ["Bruto", "Berat kotor (berat barang + kemasan)"],
              ["Neto", "Berat bersih (berat barang saja)"],
              ["Tara", "Berat kemasan"]
            ]},
            { "type": "math", "tex": "Bruto = Neto + Tara", "display": true },
            { "type": "highlight", "text": "Persentase tara = (Tara/Bruto) × 100%" }
          ]
        }
      ],
      "flashcards": [
        { "id": "fc1", "question": "Rumus persentase untung?", "answer": "(Untung/Harga beli) × 100%" },
        { "id": "fc2", "question": "Apa itu neto?", "answer": "Berat bersih (berat barang tanpa kemasan)" },
        { "id": "fc3", "question": "Bruto = ?", "answer": "Neto + Tara" },
        { "id": "fc4", "question": "Harga 100.000 diskon 20%, jadi?", "answer": "80.000 (100.000 × 80%)" }
      ],
      "quiz": {
        "questions": [
          { "id": "q1", "type": "multiple_choice", "question": "Beli Rp50.000, jual Rp60.000. Persentase untung?", "options": ["10%", "20%", "15%", "25%"], "answer": 1, "explanation": "Untung = 10.000, %untung = 10.000/50.000 × 100% = 20%" },
          { "id": "q2", "type": "multiple_choice", "question": "Bruto 5 kg, tara 500 g. Neto = ?", "options": ["4,5 kg", "5,5 kg", "4 kg", "5 kg"], "answer": 0 }
