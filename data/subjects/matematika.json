      "title": "Statistika",
      "description": "Mean, median, modus, dan penyajian data",
      "bookmarked": false,
      "lessons": [
        {
          "id": "ukuran-pemusatan",
          "title": "Ukuran Pemusatan Data",
          "estMinutes": 10,
          "content": [
            { "type": "heading", "text": "Ukuran Pemusatan Data" },
            { "type": "heading", "level": 2, "text": "Mean (Rata-rata)" },
            { "type": "math", "tex": "\\bar{x} = \\frac{\\sum x_i}{n}", "display": true },
            { "type": "heading", "level": 2, "text": "Median (Nilai Tengah)" },
            { "type": "list", "items": [
              "Data ganjil: nilai tengah setelah diurutkan",
              "Data genap: rata-rata dua nilai tengah"
            ]},
            { "type": "heading", "level": 2, "text": "Modus (Nilai Terbanyak)" },
            { "type": "text", "text": "Nilai yang paling sering muncul dalam data." },
            { "type": "heading", "level": 2, "text": "Contoh" },
            { "type": "text", "text": "Data: 5, 7, 7, 8, 9, 10" },
            { "type": "list", "items": [
              "Mean = (5+7+7+8+9+10)/6 = 46/6 ≈ 7,67",
              "Median = (7+8)/2 = 7,5",
              "Modus = 7 (muncul 2 kali)"
            ]},
            { "type": "heading", "level": 2, "text": "Penyajian Data" },
            { "type": "list", "items": [
              "Diagram batang: membandingkan kategori",
              "Diagram garis: menunjukkan perubahan",
              "Diagram lingkaran: menunjukkan proporsi"
            ]}
          ]
        }
      ],
      "flashcards": [
        { "id": "fc1", "question": "Rumus mean?", "answer": "Jumlah data ÷ banyak data" },
        { "id": "fc2", "question": "Apa itu modus?", "answer": "Nilai yang paling sering muncul" },
        { "id": "fc3", "question": "Median data 3,5,7,9,11?", "answer": "7 (nilai tengah)" },
        { "id": "fc4", "question": "Diagram untuk proporsi?", "answer": "Diagram lingkaran (pie chart)" }
