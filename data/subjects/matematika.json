    {
      "id": "peluang",
      "title": "Peluang",
      "description": "Peluang kejadian dan frekuensi harapan",
      "bookmarked": false,
      "lessons": [
        {
          "id": "peluang-dasar",
          "title": "Konsep Peluang",
          "estMinutes": 8,
          "content": [
            { "type": "heading", "text": "Peluang Kejadian" },
            { "type": "math", "tex": "P(A) = \\frac{n(A)}{n(S)}", "display": true },
            { "type": "text", "text": "P(A) = peluang kejadian A, n(A) = banyak kejadian A, n(S) = banyak ruang sampel" },
            { "type": "heading", "level": 2, "text": "Sifat Peluang" },
            { "type": "list", "items": [
              "0 ≤ P(A) ≤ 1",
              "P(A) = 0 → kejadian mustahil",
              "P(A) = 1 → kejadian pasti",
              "P(A) + P(A') = 1"
            ]},
            { "type": "heading", "level": 2, "text": "Frekuensi Harapan" },
            { "type": "math", "tex": "F_h = n \\times P(A)", "display": true },
            { "type": "text", "text": "n = banyak percobaan" },
            { "type": "highlight", "text": "Contoh: Peluang dadu muncul 6 = 1/6. Jika dilempar 60 kali, frekuensi harapan = 60 × 1/6 = 10 kali." }
          ]
        }
      ],
      "flashcards": [
        { "id": "fc1", "question": "Rumus peluang?", "answer": "P(A) = n(A)/n(S)" },
        { "id": "fc2", "question": "Peluang dadu muncul genap?", "answer": "3/6 = 1/2 (ada 3 angka genap)" },
        { "id": "fc3", "question": "Rumus frekuensi harapan?", "answer": "Fh = n × P(A)" },
        { "id": "fc4", "question": "Nilai peluang selalu antara?", "answer": "0 sampai 1" }
      ],
      "quiz": {
