            { "type": "heading", "level": 2, "text": "Unsur Berita (ADIKSIMBA / 5W+1H)" },
            { "type": "table", "headers": ["Singkatan", "Pertanyaan", "Keterangan"], "rows": [
              ["Apa (What)", "Apa yang terjadi?", "Peristiwa"],
              ["Di mana (Where)", "Di mana kejadiannya?", "Tempat"],
              ["Kapan (When)", "Kapan terjadi?", "Waktu"],
              ["Siapa (Who)", "Siapa yang terlibat?", "Pelaku"],
              ["Mengapa (Why)", "Mengapa terjadi?", "Penyebab"],
              ["Bagaimana (How)", "Bagaimana prosesnya?", "Kronologi"]
            ]},
            { "type": "heading", "level": 2, "text": "Struktur Teks Berita" },
            { "type": "list", "ordered": true, "items": [
              "Judul (headline)",
              "Teras berita (lead) — ringkasan berita",
              "Tubuh berita — uraian lengkap",
