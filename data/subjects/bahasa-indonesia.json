          "estMinutes": 10,
          "content": [
            { "type": "heading", "text": "Unsur-unsur Puisi" },
            { "type": "heading", "level": 2, "text": "Unsur Batin (Intrinsik)" },
            { "type": "list", "items": [
              "Tema — pokok pikiran puisi",
              "Rasa — sikap penyair terhadap tema",
              "Nada — sikap penyair terhadap pembaca",
              "Amanat — pesan yang ingin disampaikan"
            ]},
            { "type": "heading", "level": 2, "text": "Unsur Fisik" },
            { "type": "list", "items": [
              "Diksi — pilihan kata",
              "Imaji — gambaran indera (visual, auditif, taktil)",
              "Rima — persamaan bunyi akhir baris",
              "Ritme — irama dalam puisi",
              "Tipografi — bentuk visual puisi"
            ]},
            { "type": "heading", "level": 2, "text": "Majas dalam Puisi" },
            { "type": "table", "headers": ["Majas", "Pengertian", "Contoh"], "rows": [
              ["Personifikasi", "Benda mati seperti manusia", "Angin berbisik lembut"],
              ["Metafora", "Perbandingan langsung", "Hidupnya bagai mimpi"],
              ["Hiperbola", "Berlebihan", "Menangis darah"],
              ["Litotes", "Merendahkan diri", "Gubuk kecil saya"]
            ]}
          ]
        }
      ],
      "flashcards": [
        { "id": "fc1", "question": "4 unsur batin puisi?", "answer": "Tema, rasa, nada, amanat" },
        { "id": "fc2", "question": "Apa itu diksi?", "answer": "Pilihan kata dalam puisi" },
        { "id": "fc3", "question": "Apa itu rima?", "answer": "Persamaan bunyi akhir baris" },
        { "id": "fc4", "question": "Majas personifikasi?", "answer": "Benda mati digambarkan seperti manusia" }
      ],
      "quiz": {
        "questions": [
          { "id": "q1", "type": "multiple_choice", "question": "Pesan yang disampaikan penyair disebut?", "options": ["Tema", "Rasa", "Nada", "Amanat"], "answer": 3 },
          { "id": "q2", "type": "multiple_choice", "question": "'Angin menari-nari' menggunakan majas?", "options": ["Metafora", "Personifikasi", "Hiperbola", "Litotes"], "answer": 1 }
        ]
      }
    },
