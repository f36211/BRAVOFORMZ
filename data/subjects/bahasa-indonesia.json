        { "id": "fc2", "question": "Apa itu teras berita?", "answer": "Ringkasan berita di awal (lead)" },
        { "id": "fc3", "question": "Kata baku dari 'aktifitas'?", "answer": "aktivitas" },
        { "id": "fc4", "question": "Kata baku dari 'nasehat'?", "answer": "nasihat" }
      ],
      "quiz": {
