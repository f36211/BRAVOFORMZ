            {
              "type": "table",
              "headers": [
                "Bentuk",
                "Pengertian"
              ],
              "rows": [
                [
                  "Persaingan",
                  "Berlomba mencapai tujuan"
                ],
                [
                  "Kontravensi",
                  "Sikap tidak suka tersembunyi"
                ],
                [
                  "Konflik",
                  "Pertentangan terbuka"
                ]
              ]
            },
            {
              "type": "highlight",
              "text": "Sosialisasi adalah proses belajar nilai dan norma dalam masyarakat."
