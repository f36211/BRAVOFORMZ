          "estMinutes": 10,
          "content": [
            {
              "type": "heading",
              "text": "Globalisasi"
            },
            {
              "type": "text",
              "text": "Globalisasi adalah proses integrasi dunia tanpa batas geografis, ditandai dengan kemajuan teknologi dan komunikasi."
            },
            {
              "type": "heading",
              "level": 2,
              "text": "Dampak Positif"
            },
            {
              "type": "list",
              "items": [
                "Kemudahan akses informasi",
                "Peningkatan ilmu pengetahuan",
                "Kemajuan teknologi",
                "Peluang ekonomi global"
              ]
            },
            {
              "type": "heading",
              "level": 2,
              "text": "Dampak Negatif"
            },
            {
              "type": "list",
              "items": [
                "Lunturnya budaya lokal",
                "Konsumerisme",
                "Kesenjangan sosial",
                "Masuknya budaya asing negatif"
              ]
            },
            {
              "type": "heading",
              "level": 2,
              "text": "Sikap Menghadapi Globalisasi"
            },
            {
              "type": "list",
              "items": [
                "Selektif terhadap budaya asing",
                "Melestarikan budaya lokal",
                "Meningkatkan kualitas SDM",
                "Berpikir kritis"
              ]
            },
            {
              "type": "highlight",
              "text": "Kearifan lokal adalah nilai-nilai luhur budaya daerah yang perlu dilestarikan."
            }
          ]
        }
      ],
      "flashcards": [
        {
          "id": "fc1",
          "question": "Apa itu globalisasi?",
          "answer": "Proses integrasi dunia tanpa batas geografis"
        },
        {
          "id": "fc2",
          "question": "Dampak positif globalisasi?",
          "answer": "Kemudahan akses informasi, kemajuan teknologi"
        },
        {
          "id": "fc3",
          "question": "Dampak negatif globalisasi?",
          "answer": "Lunturnya budaya lokal, konsumerisme"
        },
        {
          "id": "fc4",
          "question": "Sikap menghadapi globalisasi?",
          "answer": "Selektif, melestarikan budaya lokal"
        }
      ],
