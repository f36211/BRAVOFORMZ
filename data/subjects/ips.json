                "Bentuk",
                "Pengertian",
                "Contoh"
              ],
              "rows": [
                [
                  "Kerja sama",
                  "Bekerja bersama mencapai tujuan",
                  "Gotong royong"
                ],
                [
                  "Akomodasi",
                  "Menyelesaikan konflik",
                  "Mediasi, arbitrasi"
                ],
                [
                  "Asimilasi",
                  "Peleburan budaya",
                  "Perkawinan beda suku"
                ],
                [
                  "Akulturasi",
                  "Percampuran budaya tanpa hilang",
                  "Wayang Wahyu"
                ]
              ]
            },
            {
              "type": "heading",
              "level": 2,
              "text": "Bentuk Interaksi Disosiatif (Negatif)"
