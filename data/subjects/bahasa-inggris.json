      "lessons": [
        {
          "id": "simple-present",
          "title": "Simple Present Tense",
          "estMinutes": 8,
          "content": [
            { "type": "heading", "text": "Simple Present Tense" },
            {
              "type": "text",
              "text": "Simple Present Tense digunakan untuk menyatakan kebiasaan, fakta umum, atau kebenaran yang berlaku saat ini."
            },
            { "type": "heading", "level": 2, "text": "Rumus" },
            {
              "type": "table",
              "headers": ["Bentuk", "Pola"],
              "rows": [
                ["(+) Positif", "S + V1 (s/es) + O"],
                ["(-) Negatif", "S + do/does + not + V1 + O"],
                ["(?) Tanya", "Do/Does + S + V1 + O?"]
              ]
            },
            { "type": "heading", "level": 2, "text": "Contoh" },
            {
              "type": "list",
              "items": [
                "She reads a book every night.",
                "They do not play football on Sunday.",
                "Does he speak English?",
                "The sun rises in the east."
              ]
            },
            { "type": "heading", "level": 2, "text": "Time Signal" },
            {
              "type": "list",
              "items": [
                "every day / week / month",
                "always, usually, often, sometimes, never",
                "on Mondays, on weekends"
              ]
            },
            { "type": "highlight", "text": "Untuk subjek He / She / It → tambahkan -s atau -es pada kata kerja." }
          ]
        }
      ],
      "flashcards": [
        { "id": "fc1", "question": "Pola Simple Present positif?", "answer": "S + V1(s/es) + O" },
        { "id": "fc2", "question": "Bentuk negatif dari 'She likes tea'?", "answer": "She does not like tea." },
        { "id": "fc3", "question": "Apa time signal Simple Present?", "answer": "every day, always, usually, often" },
        { "id": "fc4", "question": "Subjek apa yang pakai -s/-es?", "answer": "He, She, It" }
      ],
      "quiz": {
        "questions": [
          {
            "id": "q1",
            "type": "multiple_choice",
            "question": "Choose the correct sentence:",
            "options": [
              "He go to school every day.",
              "He goes to school every day.",
              "He going to school every day.",
              "He gone to school every day."
            ],
            "answer": 1,
            "explanation": "Subjek 'He' → kata kerja 'go' menjadi 'goes' (tambah -es)."
          },
          {
            "id": "q2",
            "type": "multiple_choice",
            "question": "Negative form: 'They play tennis.'",
            "options": [
              "They not play tennis.",
              "They does not play tennis.",
              "They do not play tennis.",
              "They no play tennis."
            ],
            "answer": 2
          }
        ]
      }
    },
