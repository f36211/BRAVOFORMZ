            {
              "type": "heading",
              "text": "Sejarah Perumusan Pancasila"
            },
            {
              "type": "heading",
              "level": 2,
              "text": "BPUPKI (Dokuritsu Junbi Choosakai)"
            },
            {
              "type": "text",
              "text": "BPUPKI adalah badan bentukan Jepang untuk mempersiapkan kemerdekaan Indonesia."
            },
            {
              "type": "list",
              "items": [
                "Sidang pertama: 29 Mei - 1 Juni 1945 (membahas dasar negara)",
                "Sidang kedua: 10-16 Juli 1945 (membahas rancangan UUD)"
              ]
            },
            {
              "type": "heading",
              "level": 2,
              "text": "Tokoh Pengusul Dasar Negara"
            },
            {
              "type": "table",
              "headers": [
                "Tokoh",
                "Tanggal",
                "Usulan"
              ],
              "rows": [
                [
                  "Muh. Yamin",
                  "29 Mei 1945",
                  "Peri Kebangsaan, Peri Kemanusiaan, Peri Ketuhanan, Peri Kerakyatan, Kesejahteraan Sosial"
                ],
                [
                  "Soepomo",
                  "31 Mei 1945",
                  "Persatuan, Kekeluargaan, Keseimbangan lahir batin, Musyawarah, Keadilan rakyat"
                ],
                [
                  "Soekarno",
                  "1 Juni 1945",
                  "Kebangsaan, Internasionalisme, Mufakat/Demokrasi, Kesejahteraan Sosial, Ketuhanan YME"
                ]
              ]
            },
            {
              "type": "highlight",
              "text": "1 Juni 1945 ditetapkan sebagai Hari Lahir Pancasila"
            },
            {
              "type": "heading",
              "level": 2,
              "text": "Piagam Jakarta"
            },
            {
              "type": "text",
              "text": "Disusun oleh Panitia Sembilan pada 22 Juni 1945. Sila pertama berbunyi 'Ketuhanan dengan kewajiban menjalankan syariat Islam bagi pemeluk-pemeluknya'."
            },
            {
              "type": "text",
              "text": "Ditentang warga Indonesia Timur karena dianggap tidak mengakomodasi semua warga negara. Kemudian diubah menjadi 'Ketuhanan Yang Maha Esa'."
            },
            {
              "type": "heading",
              "level": 2,
              "text": "PPKI (Dokuritsu Zyunbi Inkai)"
            },
            {
              "type": "text",
              "text": "PPKI menggantikan BPUPKI untuk mempersiapkan kemerdekaan. Pada 18 Agustus 1945, PPKI menetapkan UUD 1945 dan memilih Soekarno sebagai presiden."
            }
          ]
        }
      ],
