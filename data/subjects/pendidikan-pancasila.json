          "estMinutes": 8,
          "content": [
            {
              "type": "heading",
              "text": "Norma dalam Kehidupan"
            },
            {
              "type": "text",
              "text": "Norma adalah aturan atau pedoman perilaku dalam masyarakat."
            },
            {
              "type": "table",
              "headers": [
                "Jenis Norma",
                "Sumber",
                "Sanksi Pelanggaran"
              ],
              "rows": [
                [
                  "Agama",
                  "Wahyu Tuhan/kitab suci",
                  "Dosa"
                ],
                [
                  "Kesusilaan",
                  "Hati nurani",
                  "Penyesalan"
                ],
                [
                  "Kesopanan",
                  "Adat dan kebiasaan masyarakat",
                  "Pengucilan"
                ],
                [
                  "Hukum",
                  "Peraturan perundang-undangan",
                  "Penjara/denda"
                ]
              ]
            },
            {
              "type": "heading",
              "level": 2,
              "text": "Contoh Norma"
            },
            {
              "type": "list",
              "items": [
                "Norma agama: menjalankan ibadah, tidak berbohong",
                "Norma kesusilaan: tidak menipu, menghormati orang tua",
                "Norma kesopanan: mengucapkan salam, tidak berkata kasar",
                "Norma hukum: tidak mencuri, mematuhi rambu lalu lintas"
              ]
            },
            {
              "type": "highlight",
              "text": "Norma hukum bersifat memaksa dan memiliki sanksi tegas dari negara."
            }
          ]
        }
      ],
      "flashcards": [
        {
